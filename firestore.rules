rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'katlearn.admin@gmail.com';
    }

    function isTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /publicPacks/{packId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /classes/{classId} {
      allow read, write: if isAdmin() || isTeacher();
      match /members/{memberId} {
        allow read, write: if isAdmin() || isTeacher();
      }
    }

    match /users/{userId} {
      // A user may create only a normal student profile. Teacher/admin roles
      // must be provisioned by an administrator, not self-assigned.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', 'student') == 'student'
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('energy', 0) == 0
        && request.resource.data.get('streak', 0) == 0
        && request.resource.data.get('knownWords', 0) == 0
        && request.resource.data.get('questionsAnswered', 0) == 0
        && request.resource.data.get('correctAnswers', 0) == 0
        ;

      // Leaderboard currently reads user summary fields; keep this read public to authenticated users until a dedicated leaderboard collection is introduced.
      allow read: if request.auth != null;

      // Keep server-controlled privilege/gamification fields immutable from the client.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','coins','energy','streak','knownWords','questionsAnswered','correctAnswers','ownedThemes']);

      allow delete: if false;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /attempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personalPacks/{packId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}