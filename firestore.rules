rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'katlearn.admin@gmail.com';
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /publicPacks/{packId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /classInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
    }

    match /classes/{classId} {
      allow get: if isAdmin()
        || isTeacher()
        || (signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));
      allow list: if isAdmin() || isTeacher();

      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      match /members/{memberId} {
        allow read: if isAdmin()
          || (isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid)
          || (signedIn() && memberId == request.auth.uid);

        allow create: if isAdmin()
          || (isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid)
          || (signedIn()
            && memberId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.joinCode is string
            && exists(/databases/$(database)/documents/classInvites/$(request.resource.data.joinCode))
            && get(/databases/$(database)/documents/classInvites/$(request.resource.data.joinCode)).data.classId == classId
            && get(/databases/$(database)/documents/classInvites/$(request.resource.data.joinCode)).data.active == true);

        allow update, delete: if isAdmin()
          || (isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid)
          || (signedIn() && memberId == request.auth.uid);
      }
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'student') == 'student'
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('energy', 0) == 0
        && request.resource.data.get('streak', 0) == 0
        && request.resource.data.get('knownWords', 0) == 0
        && request.resource.data.get('questionsAnswered', 0) == 0
        && request.resource.data.get('correctAnswers', 0) == 0;

      allow read: if signedIn();

      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','coins','energy','streak','questionsAnswered','correctAnswers','ownedThemes']);

      allow delete: if false;

      match /items/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /attempts/{attemptId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /personalPacks/{packId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}