# KatLearn — Full Environment Bootstrap
#
# SECRET SAFETY
# - File này CHỈ là template. Không điền secret thật rồi commit.
# - Production/Preview secrets: Netlify site dashboard → Site configuration → Environment variables.
# - Local secrets: .env.local (đã được gitignore).
#
# QUICK SETUP FOR THE NETLIFY SITE
# 1) Add GEMINI_API_KEY.
# 2) Add ONE Firebase Admin credential route:
#    - Recommended: FIREBASE_SERVICE_ACCOUNT_JSON
#    - Alternative: FIREBASE_SERVICE_ACCOUNT_JSON_BASE64
#    - Or use the 3-part route: FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
# 3) GEMINI_MODEL is optional.
# 4) PORT is local-development only; Netlify manages the Functions runtime.
#
# The browser Firebase config is intentionally public and currently lives in
# firebase-service.js. It is NOT a server secret and must not be replaced by
# a private API key.

# =========================================================
# KAT AI / GEMINI
# =========================================================

# Required for /api/ai-pack and other Kat AI endpoints.
GEMINI_API_KEY=

# Optional compatibility alias. GEMINI_API_KEY takes priority.
# GOOGLE_API_KEY=

# Optional model override. The server has automatic Gemini model fallbacks.
GEMINI_MODEL=gemini-3.5-flash-lite

# =========================================================
# FIREBASE ADMIN — CHOOSE ONE CREDENTIAL ROUTE
# =========================================================

# ---- Route A: complete service-account JSON (recommended) ----
# Paste the COMPLETE Google/Firebase service-account JSON as one value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Route B: complete service-account JSON encoded as base64 ----
# Use this when multiline/private-key formatting is inconvenient.
# Base64 is NOT encryption; treat the value as a secret.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# ---- Route C: individual service-account fields ----
# All three are required when using this route.
# FIREBASE_PROJECT_ID=elp---katlearn
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# =========================================================
# FIREBASE ADMIN — COMPATIBILITY ALIASES ALREADY SUPPORTED
# =========================================================

# The server also accepts these aliases instead of Route A:
# FIREBASE_ADMIN_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_CREDENTIALS_JSON=

# Base64 aliases:
# FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=
# GOOGLE_CREDENTIALS_JSON_BASE64=

# Project-id aliases:
# FIREBASE_ADMIN_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT=

# Client-email aliases:
# FIREBASE_ADMIN_CLIENT_EMAIL=
# GOOGLE_CLIENT_EMAIL=

# Private-key aliases:
# FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_PRIVATE_KEY=

# =========================================================
# LOCAL DEVELOPMENT
# =========================================================

# Optional local HTTP port for dev-server.js.
PORT=3000

# =========================================================
# NETLIFY / BUILD-TIME SITE CONFIGURATION
# =========================================================
# Configure these in Netlify's Site configuration when overriding defaults.
# KATLEARN_LMS_URL=https://lms-katlearn.netlify.app
# KATLEARN_TEACHER_URL=https://teacher-katlearn.netlify.app
# KATLEARN_ALLOWED_ORIGINS=https://teacher-katlearn.netlify.app,https://lms-katlearn.netlify.app
#
# Netlify provides platform system variables automatically. They are not
# application secrets and should not be copied into this template.
#
# =========================================================
# KATLEARN FIXED SERVER CONFIG (NOT ENV VARS)
# =========================================================
# Firebase project: elp---katlearn
# Admin email: katlearn.admin@gmail.com
# LMS: https://lms-katlearn.netlify.app
# Teacher: https://teacher-katlearn.netlify.app
#
# These are currently enforced by server/client code. Keep the Firebase
# credentials pointed at project "elp---katlearn".
