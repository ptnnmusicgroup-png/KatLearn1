GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to a current production Gemini Flash-Lite model. If the configured model is unavailable, the server automatically falls back to another supported model.\nGEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Server-side Firebase Admin auth
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
