# KatLearn standalone Node.js server configuration.
# Copy this file to .env.local and keep all real credentials out of Git.

# Server binding. Keep 127.0.0.1 for local-only use.
# Only use 0.0.0.0 after configuring network/firewall protection.
HOST=127.0.0.1
PORT=3000

# Firebase Admin credential. Base64 is NOT encryption; treat it as a private secret.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional Gemini API key for Kat AI endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional cross-origin access. Use exact origins, comma-separated.
KATLEARN_ALLOWED_ORIGINS=

# Set true only when requests reach this server exclusively through Cloudflare.
KATLEARN_TRUST_CF_CONNECTING_IP=false

# Optional public origins for links and Teacher SSO. Leave blank until hosted.
KATLEARN_LMS_SITE_URL=
KATLEARN_TEACHER_SITE_URL=
