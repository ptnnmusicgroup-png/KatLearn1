FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 KATLEARN_BACKEND_MODE=lms
COPY package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY api ./api
COPY data ./data
COPY cloudflare-api ./cloudflare-api
EXPOSE 8080
CMD ["node", "cloudflare-api/server.mjs"]
